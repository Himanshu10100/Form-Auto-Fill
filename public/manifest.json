{
    "manifest_version": 3,
    "name": "Job Auto Fill",
    "version": "1.0",
    "action": {
      "default_popup": "index.html"
    },
    "permissions": ["tabs", "scripting", "activeTab"],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ]
  }
  